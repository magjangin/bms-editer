<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:bms_editer.ViewModels"
        xmlns:controls="using:bms_editer.Views.Controls"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="bms_editer.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="bms editer"
        Width="1280" Height="720">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="파일 (F)">
                <MenuItem Header="새로 만들기" Command="{Binding NewFileCommand}" />
                <MenuItem Header="열기..." Click="OnOpenFileClick" />
                <MenuItem Header="저장" Click="OnSaveFileClick" />
                <MenuItem Header="다른 이름으로 저장..." Click="OnSaveFileAsClick" />
            </MenuItem>
            <MenuItem Header="편집 (E)" />
            <MenuItem Header="View" />
            <MenuItem Header="설정 (O)" />
            <MenuItem Header="보기 (C)" />
            <MenuItem Header="프리뷰 (P)" />
        </Menu>

        <Border DockPanel.Dock="Top" Padding="6,4" BorderThickness="0,0,0,1" BorderBrush="Gray">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="새로" Command="{Binding NewFileCommand}" />
                <Button Content="열기" Click="OnOpenFileClick" />
                <Button Content="저장" Click="OnSaveFileClick" />
                <Separator />
                <Button Content="📊" Click="OnShowStatsClick" ToolTip.Tip="노트 통계" />
                <ToggleButton Content="✏️" IsChecked="{Binding IsEditMode}" />
                <Button Content="🧰" Click="OnShowNoteSearchClick" ToolTip.Tip="검색/삭제/교체" />
                <Button Content="🎨" Click="OnShowWavPaletteClick" ToolTip.Tip="키음 팔레트 (별도 창)" />
                <Separator />
                <Button Content="OGG 열기" Click="OnLoadOggClick" />
                <Button Content="비디오 열기" Click="OnLoadVideoClick" />
                <Button Content="폴더 열기" Click="OnOpenFolderClick" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="8,2" BorderThickness="0,1,0,0" BorderBrush="Gray">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="{Binding Bpm, StringFormat='BPM: {0}'}" />
                <TextBlock Text="{Binding GridDisplay, StringFormat='Grid: {0}'}" />
                <TextBlock Text="{Binding OggFileName, StringFormat='OGG: {0}', TargetNullValue='OGG: (없음)'}" />
                <TextBlock Text="{Binding VideoFileName, StringFormat='Video: {0}', TargetNullValue='Video: (없음)'}" />
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,4,320">
            <ScrollViewer x:Name="EditorScrollViewer"
                          Grid.Column="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          AllowAutoHide="False">
                <StackPanel x:Name="EditorSurface"
                            Orientation="Horizontal"
                            PointerPressed="OnEditorSurfacePointerPressed"
                            PointerMoved="OnEditorSurfacePointerMoved">
                    <controls:OggWaveformControl
                        x:Name="Waveform"
                        Width="220"
                        MeasureCount="{Binding MeasureCount}"
                        RowHeight="{Binding RowHeight}"
                        VerticalZoom="{Binding VerticalZoom}"
                        HorizontalZoom="{Binding WaveformHorizontalZoom}"
                        BeatSplit="{Binding BeatSplit}"
                        GridMeasure="{Binding GridMeasure}"
                        Bpm="{Binding Bpm}"
                        Peaks="{Binding OggPeaks}"
                        Onsets="{Binding OggOnsets}"
                        DurationSeconds="{Binding OggDurationSeconds}"
                        PlaybackPositionSeconds="{Binding PlaybackPositionSeconds}"
                        IsPlaybackCursorVisible="{Binding IsPlaybackCursorVisible}"
                        IsGridSyncFlashVisible="{Binding IsGridSyncFlashVisible}"
                        IsHorizontalView="{Binding IsHorizontalView}" />
                    <controls:NoteGridControl
                        Lanes="{Binding Chart.Lanes}"
                        MeasureCount="{Binding MeasureCount}"
                        RowHeight="{Binding RowHeight}"
                        VerticalZoom="{Binding VerticalZoom}"
                        LaneWidth="40"
                        HorizontalZoom="{Binding HorizontalZoom}"
                        BeatSplit="{Binding BeatSplit}"
                        GridMeasure="{Binding GridMeasure}"
                        Bpm="{Binding Bpm}"
                        DurationSeconds="{Binding OggDurationSeconds}"
                        PlaybackPositionSeconds="{Binding PlaybackPositionSeconds}"
                        IsPlaybackCursorVisible="{Binding IsPlaybackCursorVisible}"
                        IsGridSyncFlashVisible="{Binding IsGridSyncFlashVisible}"
                        IsHorizontalView="{Binding IsHorizontalView}"
                        Notes="{Binding Notes}"
                        IsCircleNoteShape="{Binding IsCircleNoteShape}"
                        IsEditMode="{Binding IsEditMode}"
                        SelectedNotes="{Binding SelectedNotes}"
                        PlaceNoteCommand="{Binding PlaceNoteCommand}"
                        RemoveNoteCommand="{Binding RemoveNoteCommand}"
                        SelectNotesCommand="{Binding SelectNotesCommand}"
                        KeyDown="OnNoteGridKeyDown"
                        Focusable="True" />
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Background="Gray" />

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8" Margin="8">
                    <TextBlock Text="VIDEO PREVIEW" FontWeight="Bold" />
                    <Border Height="170"
                            Background="#0A0A0C"
                            BorderBrush="DimGray"
                            BorderThickness="1">
                        <controls:VideoPreviewControl x:Name="VideoPreview" />
                    </Border>
                    <TextBlock Text="{Binding VideoFileName, TargetNullValue='비디오 없음'}"
                               TextTrimming="CharacterEllipsis"
                               Opacity="0.75" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="비디오 열기" Click="OnLoadVideoClick" />
                        <Button Content="제거" Click="OnClearVideoClick" />
                    </StackPanel>

                    <TextBlock Text="HEADER" FontWeight="Bold" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="#TITLE" />
                        <TextBox Text="{Binding Title}" />
                        <TextBlock Text="#ARTIST" />
                        <TextBox Text="{Binding Artist}" />
                        <TextBlock Text="#GENRE" />
                        <TextBox Text="{Binding Genre}" />
                        <TextBlock Text="#BPM" />
                        <NumericUpDown Value="{Binding Bpm}" Minimum="1" Maximum="999" FormatString="0.0000" />
                        <TextBlock Text="#PLAYER" />
                        <ComboBox SelectedIndex="{Binding Player}" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="1 - Single" />
                            <ComboBoxItem Content="2 - Couple" />
                            <ComboBoxItem Content="3 - Double" />
                        </ComboBox>
                        <TextBlock Text="#RANK" />
                        <ComboBox SelectedIndex="{Binding Rank}" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="0 - VeryHard" />
                            <ComboBoxItem Content="1 - Hard" />
                            <ComboBoxItem Content="2 - Normal" />
                            <ComboBoxItem Content="3 - Easy" />
                        </ComboBox>
                        <TextBlock Text="#LEVEL" />
                        <TextBox Text="{Binding Level}" />
                    </StackPanel>

                    <TextBlock Text="격자" FontWeight="Bold" Margin="0,12,0,0" />
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="비트" />
                                <NumericUpDown Value="{Binding BeatSplit}" Minimum="1" Maximum="192" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="/" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock Text="마디" />
                                <NumericUpDown Value="{Binding GridMeasure}" Minimum="1" Maximum="48" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="세로 줌" VerticalAlignment="Center" Width="60" />
                            <Slider Value="{Binding VerticalZoom}" Minimum="4" Maximum="8" Width="150" />
                            <TextBlock Text="{Binding VerticalZoom, StringFormat={}{0:0.00}}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="그리드 가로 줌" VerticalAlignment="Center" Width="90" />
                            <Slider Value="{Binding HorizontalZoom}" Minimum="0.25" Maximum="4" Width="150" />
                            <TextBlock Text="{Binding HorizontalZoom, StringFormat={}{0:0.00}}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="파형 가로 줌" VerticalAlignment="Center" Width="90" />
                            <Slider Value="{Binding WaveformHorizontalZoom}" Minimum="0.25" Maximum="4" Width="150" />
                            <TextBlock Text="{Binding WaveformHorizontalZoom, StringFormat={}{0:0.00}}" VerticalAlignment="Center" />
                        </StackPanel>
                        <CheckBox Content="재생바 따라가기" IsChecked="{Binding FollowPlaybackCursor}" />
                        <CheckBox Content="격자에 맞추기(G)" IsChecked="{Binding SnapToGrid}" />
                        <CheckBox Content="수직위치 고정(D)" IsChecked="{Binding LockVerticalPosition}" />
                        <CheckBox Content="가로 뷰로 돌리기" IsChecked="{Binding IsHorizontalView}" />
                        <CheckBox Content="네모를 동그라미로 바꾸기" IsChecked="{Binding IsCircleNoteShape}" />
                    </StackPanel>

                    <TextBlock Text="키음 (#WAV)" FontWeight="Bold" Margin="0,12,0,0" />
                    <StackPanel Spacing="4">
                        <ListBox ItemsSource="{Binding WavList}" SelectedItem="{Binding SelectedWavItem}" Height="120">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Content="키음 추가" Click="OnAddWavClick" />
                            <Button Content="키음 삭제" Command="{Binding RemoveWavCommand}" />
                            <Button Content="재생 테스트" Command="{Binding TestPlayWavCommand}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
