<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:bms_editer.ViewModels"
        mc:Ignorable="d"
        x:Class="bms_editer.Views.NoteStatsWindow"
        x:DataType="vm:NoteStatsViewModel"
        Title="노트 통계"
        Width="360" Height="560"
        MinWidth="280" MinHeight="300"
        CanMinimize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!--
      키음 목록은 ListBox 다.

      예전에는 ItemsControl 안에 Button 을 넣고 스타일로 "누를 수 있어 보이게" 만들려 했는데,
      Fluent 테마의 Button 템플릿에 가려 배경도 테두리도 화면에 나타나지 않았다.
      결국 눌리는 줄도 모르는 밋밋한 목록이 됐다.

      ListBox 는 그 일을 테마가 대신 해준다. 마우스를 올리면 밝아지고, 고르면 강조 막대가
      남고, 위아래 방향키로도 옮겨진다. 테마와 싸울 일이 없다.
      덤으로 항목 가상화가 되어 화면에 보이는 만큼만 만든다.
      (ScrollViewer 안의 ItemsControl 은 키음 628개짜리 차트에서 628줄을 전부 만들어 놓고 있었다)
    -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">

        <!-- 레인별. 이쪽은 누르는 것이 아니라 읽기만 하므로 그대로 둔다. -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="레인별 노트 개수" FontWeight="Bold" />
            <TextBlock Text="노트가 없습니다." Opacity="0.6" IsVisible="{Binding !HasLaneStats}" />
            <ItemsControl ItemsSource="{Binding Stats}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LaneNoteStat">
                        <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                            <TextBlock Grid.Column="0" Text="{Binding LaneId}" Width="48" />
                            <TextBlock Grid.Column="1" Text="{Binding Count}" HorizontalAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- 키음별 머리말과 안내 -->
        <StackPanel Grid.Row="1" Spacing="6" Margin="0,14,0,6">
            <TextBlock Text="키음별 노트 개수" FontWeight="Bold" />
            <TextBlock Text="실제로 노트에 쓰인 번호만 표시합니다." Opacity="0.6" TextWrapping="Wrap" />

            <!-- 고르면 무슨 일이 일어나는지, 그리고 방금 무엇을 골랐는지를 목록 바로 위에 적는다.
                 창 맨 아래에만 적으면 목록이 길어서 눈에 안 들어온다. -->
            <Border Background="#22FFFFFF" CornerRadius="4" Padding="8,6">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </Border>

            <TextBlock Text="쓰인 키음이 없습니다." Opacity="0.6" IsVisible="{Binding !HasWavStats}" />
        </StackPanel>

        <!-- 키음 목록. 줄을 고르면 그 노트가 격자에서 빨갛게 선택된다. -->
        <ListBox Grid.Row="2"
                 x:Name="WavStatList"
                 ItemsSource="{Binding WavStats}"
                 SelectedItem="{Binding SelectedWavStat}"
                 IsVisible="{Binding HasWavStats}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:WavNoteStat">
                    <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding FileName}">
                        <TextBlock Grid.Column="0" Text="{Binding Key, StringFormat='#{0}'}"
                                   Width="46" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding FileName}"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="2" Text="{Binding Count}"
                                   HorizontalAlignment="Right" MinWidth="30" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="3" Margin="0,10,0,0" FontWeight="Bold"
                   Text="{Binding TotalCount, StringFormat='전체 노트: {0}개'}" />
    </Grid>
</Window>
